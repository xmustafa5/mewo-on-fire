def rgba(hex_colour):
    c = Gdk.RGBA()
    c.parse(hex_colour)
    return c


def spaced(text, colour, size="9pt", weight="bold"):
    """Letter-spaced capitals, the console's label look."""
    return (
        f"<span font_family='monospace' size='{size}' weight='{weight}' letter_spacing='2600' "
        f"foreground='{colour}'>{GLib.markup_escape_text(text)}</span>"
    )


def ask_daemon(sock, request, timeout=4):
    """One JSON line to the daemon's control socket, one JSON line back."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(sock)
        s.sendall(json.dumps(request).encode() + b"\n")
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf or b"{}")


def find_tool(name):
    """A command the daemon's short PATH may not have."""
    home = os.path.expanduser("~")
    for p in (shutil.which(name), f"{home}/.local/bin/{name}", f"/usr/local/bin/{name}", f"/usr/bin/{name}", f"/snap/bin/{name}", f"/opt/homebrew/bin/{name}"):
        if p and os.access(p, os.X_OK):
            return p
    return None


def plan_detail(info):
    """The plan status and the pull request of the window's session, from the daemon."""
    out = {}
    if info.get("feature") and info.get("n"):
        try:
            d = ask_daemon(info.get("socket", ""), {"cmd": "session_detail", "feature": info["feature"], "workspace": info.get("workspace", ""), "n": info["n"]})
            ps = d.get("session") or {}
            out["status"] = ps.get("status", "")
            out["pr"] = ps.get("pr_url", "")
        except (OSError, ValueError):
            pass
    return out


class Header:
    """The title bar: the brand line and the goal on the left; the plan status, the pull request
    and the state chip on the right. And the line under it, lit by the state."""

    def __init__(self, window, chat):
        self.window = window
        self.accent, self.dim = (CORAL, CHAT_DIM) if chat else (CYAN, DIM)
        self.size = "8pt" if chat else "9pt"
        self.state = "starting"
        self.pr_url = ""
        self.status_text = ""
        self.notice = 0
        self.bar = Gtk.HeaderBar()
        self.bar.set_show_close_button(True)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
        self.brand = Gtk.Label(xalign=0)
        self.goal = Gtk.Label(xalign=0)
        self.goal.get_style_context().add_class("goal")
        self.goal.set_ellipsize(Pango.EllipsizeMode.END)
        self.goal.set_max_width_chars(70)
        titles.pack_start(self.brand, False, False, 0)
        titles.pack_start(self.goal, False, False, 0)
        self.bar.pack_start(titles)
        self.chip = Gtk.Label(label=STATES["starting"], valign=Gtk.Align.CENTER)
        self.chip.get_style_context().add_class("chip")
        self.chip.get_style_context().add_class("starting")
        self.pr = Gtk.Button(label="PULL REQUEST ↗", valign=Gtk.Align.CENTER)
        self.pr.get_style_context().add_class("pr")
        self.pr.set_no_show_all(True)
        self.pr.connect("clicked", self.open_pr)
        self.status = Gtk.Label(label="", valign=Gtk.Align.CENTER)
        self.status.get_style_context().add_class("status")
        self.bar.pack_end(self.chip)
        self.bar.pack_end(self.pr)
        self.bar.pack_end(self.status)
        self.edge = Gtk.Box()
        self.edge.get_style_context().add_class("edge")

    def set_session(self, n, goal):
        self.brand.set_markup(spaced("◉ MEWO ON FIRE", self.accent, size=self.size) + spaced(f"  ·  SESSION {n}", self.dim, size=self.size))
        self.goal.set_text(goal)

    def set_state(self, state):
        if state == self.state or state not in STATES:
            return
        for w in (self.chip, self.edge):
            ctx = w.get_style_context()
            ctx.remove_class(self.state)
            ctx.add_class(state)
        self.state = state
        self.chip.set_text(STATES[state])

    def set_status(self, text):
        self.status_text = text
        if not self.notice:
            self.status.set_markup(spaced(text, self.dim, size="8pt") if text else "")

    def set_pr(self, url):
        self.pr_url = url
        self.pr.set_visible(bool(url))

    def open_pr(self, _btn):
        if self.pr_url:
            Gtk.show_uri_on_window(self.window, self.pr_url, Gdk.CURRENT_TIME)

    def flash(self, text):
        """A word in the header for a moment, where the plan status sits."""
        self.notice += 1
        mine = self.notice
        self.status.set_markup(spaced(text, self.accent, size="8pt"))

        def back():
            if self.notice == mine:
                self.notice = 0
                self.status.set_markup(spaced(self.status_text, self.dim, size="8pt") if self.status_text else "")
            return False

        GLib.timeout_add(1200, back)


class Chat:
    """The chat body of a tab: the page in a WebKit view, connected to the session's host."""

    def __init__(self, tab, conn, reader, related):
        self.tab = tab
        self.conn, self.reader = conn, reader
        self.page_ready = False
        self.inbox = []          # events from the host, not yet seen here
        self.outbox = []         # events for the page
        self.lock = threading.Lock()
        self.send_lock = threading.Lock()
        self.files, self.files_at = None, 0.0
        self.closing = False

        if related is not None:
            # Every tab's page in the one web process (and the window's one message handler).
            web = WebKit2.WebView.new_with_related_view(related)
        else:
            web = WebKit2.WebView.new_with_user_content_manager(tab.win.manager)
        web.set_background_color(rgba(CHAT_BG))
        settings = web.get_settings()
        settings.set_enable_developer_extras(bool(os.environ.get("MEWO_SESSION_DEBUG")))
        settings.set_enable_back_forward_navigation_gestures(False)
        web.connect("decide-policy", self.on_policy)
        web.connect("context-menu", self.on_context_menu)
        web.connect("key-press-event", self.on_key)
        self.page_uri = GLib.filename_to_uri(CHAT_PAGE, None)
        web.load_uri(f"{self.page_uri}#tab={tab.id}")
        self.web = web
        self.timer = GLib.timeout_add(33, self.flush)

    # ---------- the host ----------

    def start(self):
        threading.Thread(target=self.read_host, daemon=True).start()

    def read_host(self):
        try:
            for raw in self.reader:
                try:
                    ev = json.loads(raw)
                except ValueError:
                    continue
                with self.lock:
                    self.inbox.append(ev)
        except (OSError, ValueError):
            pass
        GLib.idle_add(self.on_lost)

    def on_lost(self):
        """The host went away. With an end it said, the tab already shows it; without, say so."""
        if not self.closing and not self.tab.ended:
            self.flush()
            self.push({"type": "mewo", "kind": "exit", "code": 1, "text": "Lost the session: its host stopped."})
            self.tab.session_ended()
        return False

    def write(self, obj):
        try:
            with self.send_lock:
                self.conn.sendall(json.dumps(obj).encode() + b"\n")
            return True
        except OSError:
            return False

    def stop(self):
        """The tab closes: the session ends."""
        self.write({"t": "stop"})
        self.detach()

    def detach(self):
        """The window closes and the session goes on."""
        if self.closing:
            return
        self.closing = True
        GLib.source_remove(self.timer)
        try:
            self.conn.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        self.conn.close()

    # ---------- events ----------

    # What the page has no use for: hooks, a subagent's partial text, the frame of a message.
    QUIET_STREAM = ("message_start", "message_delta", "message_stop", "content_block_stop")

    def wanted(self, ev):
        t = ev.get("type")
        if t == "system":
            return ev.get("subtype") in ("init", "status", "compact_boundary", "api_retry")
        if t == "stream_event":
            e = ev.get("event") or {}
            if ev.get("parent_tool_use_id") or e.get("type") in self.QUIET_STREAM:
                return False
            return (e.get("delta") or {}).get("type") != "input_json_delta"
        return t in ("assistant", "user", "result", "control_request", "control_cancel_request", "control_response", "rate_limit_event", "mewo")

    def flush(self):
        with self.lock:
            fresh, self.inbox = self.inbox, []
        for ev in fresh:
            t = ev.get("type")
            if t == "mewo":
                kind = ev.get("kind")
                if kind == "show":
                    self.tab.win.show_tab(self.tab, ev.get("token", ""))
                    continue
                if kind in ("host", "live"):
                    continue
                if kind == "exit":
                    self.tab.session_ended()
            elif t == "system" and ev.get("subtype") == "init":
                self.tab.session_id = ev.get("session_id") or self.tab.session_id
            elif t == "control_request" and (ev.get("request") or {}).get("subtype") != "can_use_tool":
                continue  # the host answered it
            elif t == "control_response" and (ev.get("response") or {}).get("request_id") == "mewo-hello":
                r = (ev.get("response") or {}).get("response") or {}
                self.outbox.append({
                    "type": "mewo", "kind": "hello", "mode": r.get("current_permission_mode", ""),
                    "commands": [{"name": c.get("name", ""), "description": c.get("description", "")} for c in r.get("commands") or []],
                    "models": [{"value": m.get("value", ""), "name": m.get("displayName", ""), "description": m.get("description", ""), "resolved": m.get("resolvedModel", "")} for m in r.get("models") or []],
                })
                continue
            if self.wanted(ev):
                self.outbox.append(ev)
        if self.page_ready and self.outbox:
            batch, self.outbox = self.outbox, []
            js = "mewo.recv(" + json.dumps(batch) + ")"
            try:
                self.web.evaluate_javascript(js, -1, None, None, None, None)
            except (AttributeError, TypeError):
                self.web.run_javascript(js, None, None, None)
        return True

    def push(self, ev):
        self.outbox.append(ev)

    # ---------- the page ----------

    def on_page(self, msg):
        t = msg.get("t")
        if t == "ready":
            self.page_ready = True
        elif t == "send":
            if not self.write({"t": "send", "text": msg.get("text", ""), "images": msg.get("images") or []}):
                self.push({"type": "mewo", "kind": "note", "text": "Not sent: the window has lost the session.", "err": True})
        elif t == "respond":
            self.write({"t": "respond", "request_id": msg.get("request_id", ""), "response": msg.get("response") or {}})
        elif t in ("interrupt", "cancel_retry"):
            self.write({"t": t})
        elif t == "set_model":
            self.write({"t": "set_model", "model": msg.get("model") or "default"})
        elif t == "set_mode":
            self.write({"t": "set_mode", "mode": msg.get("mode") or "default"})
        elif t == "state":
            self.tab.set_state(msg.get("state", ""))
        elif t == "copy":
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(msg.get("text", ""), -1)
            clipboard.store()  # it outlives this window
        elif t == "url":
            self.open_uri(msg.get("url", ""))
        elif t == "open":
            self.open_path(msg.get("path", ""), int(msg.get("line") or 0))
        elif t == "files":
            threading.Thread(target=self.find_files, args=(msg.get("q", ""),), daemon=True).start()

    def open_uri(self, uri):
        if uri.startswith(("http://", "https://")):
            try:
                Gio.AppInfo.launch_default_for_uri(uri, None)
            except GLib.Error:
                pass

    def open_path(self, path, line):
        """A file Claude names opens in VS Code at its line, else in the app that owns it."""
        p = os.path.expanduser(path)
        if not os.path.isabs(p):
            p = os.path.join(self.tab.folder, p)
        if not os.path.exists(p):
            self.tab.flash("NO SUCH FILE")
            return
        code = find_tool("code")
        try:
            if code and os.path.isfile(p):
                subprocess.Popen([code, "-g", f"{p}:{line}" if line else p], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(p, None), None)
        except (OSError, GLib.Error):
            self.tab.flash("COULD NOT OPEN IT")

    def find_files(self, q):
        """The folder's files for an "@": git's list (tracked and new, not ignored), best matches first."""
        if self.files is None or time.time() - self.files_at > 30:
            try:
                out = subprocess.run(["git", "ls-files", "-co", "--exclude-standard"], cwd=self.tab.folder, capture_output=True, text=True, timeout=6).stdout.split("\n")
            except (OSError, subprocess.SubprocessError):
                out = []
            self.files, self.files_at = [f for f in out if f][:60000], time.time()
        needle = q.lower()

        def rank(f):
            low, base = f.lower(), os.path.basename(f).lower()
            if not needle:
                return (f.count("/"), len(f))
            if base.startswith(needle):
                return (0, len(f))
            if needle in base:
                return (1, len(f))
            if needle in low:
                return (2, len(f))
            return None

        scored = [(r, f) for f in self.files for r in [rank(f)] if r is not None]
        scored.sort()
        GLib.idle_add(self.push, {"type": "mewo", "kind": "files", "q": q, "files": [f for _, f in scored[:12]]})

    def on_policy(self, _web, decision, kind):
        if kind == WebKit2.PolicyDecisionType.RESPONSE:
            return False
        uri = decision.get_navigation_action().get_request().get_uri() or ""
        if uri.split("#")[0] == self.page_uri:
            return False
        decision.ignore()  # the page never leaves; its links go through open_uri
        return True

    def on_context_menu(self, _web, menu, _event, _hit):
        keep = (WebKit2.ContextMenuAction.COPY, WebKit2.ContextMenuAction.CUT, WebKit2.ContextMenuAction.PASTE, WebKit2.ContextMenuAction.SELECT_ALL)
        for item in list(menu.get_items()):
            if item.get_stock_action() not in keep:
                menu.remove(item)
        return menu.get_n_items() == 0

    def on_key(self, _web, event):
        if not event.state & Gdk.ModifierType.CONTROL_MASK:
            return False
        key = Gdk.keyval_to_lower(event.keyval)
        if key in (Gdk.KEY_equal, Gdk.KEY_plus, Gdk.KEY_minus, Gdk.KEY_0):
            zoom = 1.0 if key == Gdk.KEY_0 else max(0.7, min(2.0, self.web.get_zoom_level() + (0.1 if key != Gdk.KEY_minus else -0.1)))
            self.web.set_zoom_level(zoom)
            return True
        return False


class Tab:
    """One session in the chat window: its chat, its label on the tab strip, and what the
    header shows while it is the tab in front."""

    serial = 0

    def __init__(self, win, info, conn, reader, related):
        Tab.serial += 1
        self.id = str(Tab.serial)
        self.win, self.info = win, info
        self.folder = os.path.realpath(info.get("folder") or "/")
        self.sock_path = info.get("host_socket", "")
        self.session_id = info.get("session_id", "")
        self.state = "starting"
        self.status_text = ""
        self.pr_url = ""
        self.ended = bool(info.get("ended"))
        self.alive = not self.ended

        n, goal = info.get("n", ""), info.get("goal", "")
        box = Gtk.Box(spacing=7)
        self.dot = Gtk.Label(label="●")
        self.dot.get_style_context().add_class("tabdot")
        self.dot.get_style_context().add_class("starting")
        text = f"{n} · {goal}" if n != "" else goal or "Session"
        title = Gtk.Label(label=text)
        title.set_ellipsize(Pango.EllipsizeMode.END)
        # The notebook gives a tab what its label needs at least: that much is readable.
        title.set_width_chars(min(len(text), 22))
        title.set_max_width_chars(26)
        close = Gtk.Button(label="×", relief=Gtk.ReliefStyle.NONE, focus_on_click=False, valign=Gtk.Align.CENTER)
        close.get_style_context().add_class("tabx")
        close.set_tooltip_text("Close the session (Ctrl+W)")
        close.connect("clicked", lambda *_: self.win.close_tab(self))
        box.pack_start(self.dot, False, False, 0)
        box.pack_start(title, True, True, 0)
        box.pack_start(close, False, False, 0)
        box.set_tooltip_text("   ·   ".join(b for b in (f"Session {n}" if n != "" else "", goal, info.get("feature", ""), info.get("branch", ""), info.get("model_label", "")) if b))
        box.show_all()
        self.label = box

        self.chat = Chat(self, conn, reader, related)
        self.poller = GLib.timeout_add_seconds(5, self.poll)
        self.poll()

    def set_state(self, state):
        state = "finished" if state == "idle" else state
        if self.ended:
            state = "ended"
        if state == self.state or state not in STATES:
            return
        ctx = self.dot.get_style_context()
        ctx.remove_class(self.state)
        ctx.add_class(state)
        self.state = state
        self.win.tab_changed(self)

    def session_ended(self):
        self.alive = False
        self.ended = True
        self.set_state("ended")

    def flash(self, text):
        if self.win.current() is self:
            self.win.header.flash(text)

    def poll(self):
        threading.Thread(target=lambda: GLib.idle_add(self.show_fetched, plan_detail(self.info)), daemon=True).start()
        return True

    def show_fetched(self, out):
        changed = False
        if "status" in out and out["status"].upper() != self.status_text:
            self.status_text, changed = out["status"].upper(), True
        if out.get("pr") and out["pr"] != self.pr_url:
            self.pr_url, changed = out["pr"], True
        if changed:
            self.win.tab_changed(self)
        return False

    def close(self, stop):
        GLib.source_remove(self.poller)
        if stop and self.alive:
            self.chat.stop()
        else:
            self.chat.detach()


class SessionsWindow(Gtk.Window):
    """v3.3: every "Build with me" session in one window, a tab each."""

    def __init__(self, server):
        super().__init__(title="Mewo Session")
        self.server = server
        self.tabs = []
        self.connecting = set()
        self.set_default_size(1100, 780)
        self.get_style_context().add_class("chat")

        self.header = Header(self, chat=True)
        self.header.set_session("", "")
        self.set_titlebar(self.header.bar)

        # One handler for the pages of every tab: each message says which tab it is from.
        self.manager = WebKit2.UserContentManager()
        self.manager.register_script_message_handler("mewo")
        self.manager.connect("script-message-received::mewo", self.on_message)

        self.book = Gtk.Notebook()
        self.book.set_scrollable(True)
        self.book.set_show_border(False)
        self.book.connect("switch-page", self.on_switch)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(self.header.edge, False, False, 0)
        box.pack_start(self.book, True, True, 0)
        self.add(box)

        # Before the page sees them: the web view would take Page Up and Page Down for scrolling.
        keys = Gtk.AccelGroup()
        keys.connect(Gdk.KEY_w, Gdk.ModifierType.CONTROL_MASK, Gtk.AccelFlags.VISIBLE, self.on_close_key)
        keys.connect(Gdk.KEY_Page_Up, Gdk.ModifierType.CONTROL_MASK, Gtk.AccelFlags.VISIBLE, lambda *_: self.book.prev_page() or True)
        keys.connect(Gdk.KEY_Page_Down, Gdk.ModifierType.CONTROL_MASK, Gtk.AccelFlags.VISIBLE, lambda *_: self.book.next_page() or True)
        self.add_accel_group(keys)
        self.connect("delete-event", self.on_close)
        self.connect("destroy", self.on_destroy)
        # Told to go (a logout, a kill): the window goes, the sessions go on.
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            unix_signal_add(GLib.PRIORITY_HIGH, sig, self.on_quit_signal)
        threading.Thread(target=self.serve, daemon=True).start()

    # ---------- hosts ----------

    def serve(self):
        """Hosts that want a tab: {"attach": <host socket>, "token": <activation token>}."""
        while True:
            try:
                conn, _ = self.server.accept()
            except OSError:
                return
            try:
                with conn:
                    conn.settimeout(3)
                    line = conn.makefile("rb").readline()
                msg = json.loads(line or b"{}")
            except (OSError, ValueError):
                continue
            if msg.get("attach"):
                GLib.idle_add(self.attach, msg["attach"], msg.get("token", ""), bool(msg.get("token")))

    def attach_all(self):
        """Every session whose host is alive: what an earlier window left running."""
        try:
            names = sorted(os.listdir(WINDOWS))
        except OSError:
            return
        for name in names:
            if not name.endswith(".json"):
                continue
            try:
                with open(os.path.join(WINDOWS, name), encoding="utf-8") as f:
                    entry = json.load(f)
                os.kill(int(entry.get("pid") or 0), 0)
            except (OSError, ValueError, TypeError):
                continue
            if entry.get("socket"):
                self.attach(entry["socket"], "", False)

    def attach(self, sock_path, token, select):
        tab = next((t for t in self.tabs if t.sock_path == sock_path), None)
        if tab:
            if token or select:
                self.show_tab(tab, token)
            return False
        if sock_path in self.connecting:
            return False
        self.connecting.add(sock_path)

        def connect():
            conn = reader = info = None
            try:
                conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                conn.settimeout(5)
                conn.connect(sock_path)
                reader = conn.makefile("rb")
                first = json.loads(reader.readline() or b"{}")
                conn.settimeout(None)
                if first.get("kind") == "host":
                    info = first.get("info") or {}
                    info["host_socket"] = sock_path
            except (OSError, ValueError):
                info = None
            if info is None and conn is not None:
                conn.close()
            GLib.idle_add(self.add_tab, sock_path, info, conn, reader, token, select)

        threading.Thread(target=connect, daemon=True).start()
        return False

    def add_tab(self, sock_path, info, conn, reader, token, select):
        self.connecting.discard(sock_path)
        if info is None:
            self.close_if_empty()  # nothing to show
            return False
        if not self.tabs:
            icon = info.get("icon", "")
            if icon and os.path.exists(icon):
                self.set_icon_from_file(icon)
        related = self.tabs[0].chat.web if self.tabs else None
        tab = Tab(self, info, conn, reader, related)
        self.tabs.append(tab)
        front = select or token or len(self.tabs) == 1
        # A page takes the focus when it loads, and the notebook follows the focus: one at the back may not.
        tab.chat.web.set_can_focus(front)
        index = self.book.append_page(tab.chat.web, tab.label)
        self.book.set_tab_reorderable(tab.chat.web, True)
        tab.chat.web.show()
        tab.chat.start()
        if front:
            self.book.set_current_page(index)
        if token:
            self.come_forward(token)
        self.tab_changed(tab)
        return False

    # ---------- tabs ----------

    def current(self):
        page = self.book.get_nth_page(self.book.get_current_page())
        return next((t for t in self.tabs if t.chat.web is page), None)

    def on_switch(self, _book, page, _n):
        for t in self.tabs:
            t.chat.web.set_can_focus(t.chat.web is page)
        tab = next((t for t in self.tabs if t.chat.web is page), None)
        if tab:
            self.show_header(tab)
            GLib.idle_add(tab.chat.web.grab_focus)

    def tab_changed(self, tab):
        if self.current() is tab:
            self.show_header(tab)
        # A question waits in some tab: the dock and the shell say so, without taking the focus.
        self.set_urgency_hint(any(t.state == "waiting" for t in self.tabs))

    def show_header(self, tab):
        h = self.header
        h.set_session(tab.info.get("n", ""), tab.info.get("goal", ""))
        h.set_state(tab.state)
        h.set_status(tab.status_text)
        h.set_pr(tab.pr_url)
        self.set_title(tab.info.get("title") or "Mewo Session")

    def show_tab(self, tab, token):
        self.book.set_current_page(self.book.page_num(tab.chat.web))
        self.come_forward(token)
        tab.chat.web.grab_focus()

    def come_forward(self, token):
        self.deiconify()
        if token:
            # The console's click, handed over: with it the shell lets this window come forward.
            self.set_startup_id(token)
        else:
            self.present()

    def close_tab(self, tab):
        if tab.alive and not self.ask(
            f"Close session {tab.info.get('n', '')}?",
            "Claude stops. If the session has not opened its pull request yet, the build starts it again.",
            [("Keep it open", Gtk.ResponseType.CANCEL), ("Close", Gtk.ResponseType.OK)],
        ) == Gtk.ResponseType.OK:
            return
        tab.close(stop=True)
        self.book.remove_page(self.book.page_num(tab.chat.web))
        self.tabs.remove(tab)
        if not self.tabs:
            self.destroy()

    def on_close_key(self, *_):
        tab = self.current()
        if tab:
            self.close_tab(tab)
        return True

    def close_if_empty(self):
        if not self.tabs and not self.connecting:
            self.destroy()
        return False

    def ask(self, text, more, buttons):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE, text=text)
        dialog.format_secondary_text(more)
        for label, response in buttons:
            dialog.add_button(label, response)
        answer = dialog.run()
        dialog.destroy()
        return answer

    # ---------- the window ----------

    def on_message(self, _manager, result):
        try:
            value = result.get_js_value() if hasattr(result, "get_js_value") else result
            msg = json.loads(value.to_string())
        except (ValueError, AttributeError):
            return
        tab = next((t for t in self.tabs if t.id == str(msg.get("tab", ""))), None)
        if tab:
            tab.chat.on_page(msg)

    def on_close(self, *_):
        live = [t for t in self.tabs if t.alive]
        if not live:
            return False
        one = len(live) == 1
        answer = self.ask(
            "Close the window?",
            ("One session is" if one else f"{len(live)} sessions are") + " still running. Kept running, "
            + ("it goes on working and comes back" if one else "they go on working and come back")
            + " with the whole conversation when the window opens again (Show the session on the console). Stopped, Claude stops"
            + ("" if one else " in each") + ", and the build starts again a session that has no pull request yet.",
            [("Cancel", Gtk.ResponseType.CANCEL), ("Stop " + ("it" if one else "them"), Gtk.ResponseType.REJECT), ("Keep " + ("it" if one else "them") + " running", Gtk.ResponseType.OK)],
        )
        if answer == Gtk.ResponseType.REJECT:
            for t in live:
                t.close(stop=True)
            self.tabs = [t for t in self.tabs if t not in live]
            return False
        return answer != Gtk.ResponseType.OK

    def on_quit_signal(self):
        self.destroy()
        return GLib.SOURCE_REMOVE

    def on_destroy(self, *_):
        for t in self.tabs:
            t.close(stop=False)
        self.tabs = []
        try:
            self.server.close()
            os.unlink(WINDOW_SOCKET)
        except OSError:
            pass
        # Leave at once: the hosts keep the sessions, and on Wayland the flush that ends gtk_main can wait
        # for good. WebKit's processes end with this one.
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(0)


class SessionWindow(Gtk.Window):
    """The terminal: one session, Claude Code in a terminal, a window of its own."""

    def __init__(self, info):
        super().__init__(title=info.get("title", "Mewo Session"))
        self.info = info
        self.folder = os.path.realpath(info["folder"])
        self.alive = False
        self.ended = False
        self.state = "starting"
        self.font_scale = 1.0
        self.term = None

        self.set_default_size(1100, 760)
        icon = info.get("icon", "")
        if icon and os.path.exists(icon):
            self.set_icon_from_file(icon)
        self.get_style_context().add_class("mewo")
        self.header = Header(self, chat=False)
        self.header.set_session(info.get("n", ""), info.get("goal", ""))
        self.set_titlebar(self.header.bar)

        # Under it: where the session runs, and a line lit by its state.
        meta = Gtk.Label(xalign=0)
        meta.get_style_context().add_class("meta")
        meta.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        bits = [info.get("feature", ""), info.get("branch", ""), os.path.basename(self.folder), info.get("model_label", "")]
        meta.set_text("   ·   ".join(b for b in bits if b))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(self.header.edge, False, False, 0)
        if Vte is not None:
            box.pack_start(meta, False, False, 0)
            box.pack_start(self.build_terminal(), True, True, 0)
        else:
            sorry = Gtk.Label(label="This window needs WebKitGTK or VTE for Python:\nsudo apt install gir1.2-webkit2-4.1 gir1.2-vte-2.91")
            sorry.get_style_context().add_class("goal")
            box.pack_start(sorry, True, True, 0)
        self.add(box)
        self.connect("delete-event", self.on_close)
        self.connect("destroy", self.on_destroy)
        # The handler first, then the entry that invites the signal.
        unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_show_signal)
        self.register()
        # Told to go (a logout, a kill): close as a click on the cross would, so Claude Code ends with the window.
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            unix_signal_add(GLib.PRIORITY_HIGH, sig, self.on_quit_signal)

        if self.term:
            self.term.spawn_async(
                Vte.PtyFlags.DEFAULT, self.folder, ["/bin/sh", info["script"]], None,
                GLib.SpawnFlags.DEFAULT, None, None, -1, None, self.on_spawned,
            )
        GLib.timeout_add_seconds(2, self.poll)
        self.poll()

    def build_terminal(self):
        """The terminal, in the console's colours."""
        term = Vte.Terminal()
        term.set_colors(rgba(TEXT), rgba(BG), [rgba(c) for c in PALETTE])
        term.set_color_cursor(rgba(CYAN))
        term.set_color_cursor_foreground(rgba(BG))
        term.set_color_highlight(rgba("#1aa3d6"))
        term.set_color_highlight_foreground(rgba(BG))
        term.set_color_bold(rgba("#ffffff"))
        term.set_font(Pango.FontDescription.from_string("Ubuntu Mono, DejaVu Sans Mono, Monospace 12"))
        term.set_cursor_blink_mode(Vte.CursorBlinkMode.ON)
        term.set_cursor_shape(Vte.CursorShape.BLOCK)
        term.set_scrollback_lines(20000)
        term.set_mouse_autohide(True)
        term.connect("child-exited", self.on_exit)
        term.connect("key-press-event", self.on_key)
        term.connect("button-press-event", self.on_button)
        # A double click takes a whole path or link, not one word of it.
        term.set_word_char_exceptions("-,./?%&#:_=+@~")
        self.term = term
        scroll = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL, adjustment=term.get_vadjustment())
        # Breathing room around the text, painted in the terminal's own colour.
        term.set_margin_start(12)
        term.set_margin_top(8)
        term.set_margin_bottom(4)
        pane = Gtk.Box()
        pane.get_style_context().add_class("pane")
        pane.pack_start(term, True, True, 0)
        pane.pack_end(scroll, False, False, 0)
        return pane

    # ---------- the session ----------

    def on_spawned(self, _term, pid, error, *_):
        if error is not None or pid == -1:
            self.term.feed(f"\r\n  Could not start the session: {error.message if error else 'unknown error'}\r\n".encode())
            self.set_state("ended")
            return
        self.alive = True
        self.term.grab_focus()

    def on_exit(self, _term, _status):
        self.alive = False
        self.ended = True
        self.set_state("ended")
        self.term.feed("\r\n\x1b[38;2;123;147;171m  The session ended. You can close this window.\x1b[0m\r\n".encode())

    def on_quit_signal(self):
        self.destroy()
        return GLib.SOURCE_REMOVE

    def on_destroy(self, *_):
        for ext in ("json", "token"):
            try:
                os.remove(os.path.join(WINDOWS, f"{os.getpid()}.{ext}"))
            except OSError:
                pass

    # ---------- "Show the session" on the console ----------

    def register(self):
        """This window's entry in the list the console reads."""
        entry = {"pid": os.getpid(), "folder": self.folder, "session_id": "", "n": self.info.get("n", ""), "feature": self.info.get("feature", "")}
        path = os.path.join(WINDOWS, f"{os.getpid()}.json")
        try:
            os.makedirs(WINDOWS, exist_ok=True)
            with open(path + ".tmp", "w", encoding="utf-8") as f:
                json.dump(entry, f)
            os.replace(path + ".tmp", path)
        except OSError:
            pass

    def on_show_signal(self):
        token, path = "", os.path.join(WINDOWS, f"{os.getpid()}.token")
        try:
            if time.time() - os.path.getmtime(path) < 15:
                with open(path, encoding="utf-8") as f:
                    token = f.read().strip()
            os.remove(path)
        except OSError:
            pass
        self.deiconify()
        if token:
            # The console's click, handed over: with it the shell lets this window come forward.
            self.set_startup_id(token)
        else:
            self.present()
        if self.term:
            self.term.grab_focus()
        return GLib.SOURCE_CONTINUE

    def set_state(self, state):
        state = "finished" if state == "idle" else state
        if self.ended:
            state = "ended"
        if state == self.state or state not in STATES:
            return
        self.state = state
        self.header.set_state(state)
        # A question waits: the dock and the shell say so, without taking the focus.
        self.set_urgency_hint(state == "waiting")

    # ---------- the daemon ----------

    def poll(self):
        threading.Thread(target=self.fetch, daemon=True).start()
        return True

    def fetch(self):
        out = {}
        try:
            sessions = ask_daemon(self.info.get("socket", ""), {"cmd": "sessions"}).get("sessions") or []
            mine = [s for s in sessions if os.path.realpath(s.get("cwd") or "/") == self.folder]
            if mine:
                out["state"] = max(mine, key=lambda s: s.get("last_ts") or 0).get("state", "")
        except (OSError, ValueError):
            pass
        out.update(plan_detail(self.info))
        GLib.idle_add(self.show_fetched, out)

    def show_fetched(self, out):
        if out.get("state"):
            self.set_state(out["state"])
        if "status" in out:
            self.header.set_status(out["status"].upper())
        if out.get("pr") and out["pr"] != self.header.pr_url:
            self.header.set_pr(out["pr"])
        return False

    # ---------- keys and closing ----------

    def copy(self, *_):
        if not self.term.get_has_selection():
            return
        self.term.copy_clipboard_format(Vte.Format.TEXT)
        self.header.flash("COPIED")

    def paste(self, *_):
        self.term.paste_clipboard()

    def clipboard_has_text(self):
        return Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_is_text_available()

    def on_key(self, _term, event):
        ctrl = event.state & Gdk.ModifierType.CONTROL_MASK
        shift = event.state & Gdk.ModifierType.SHIFT_MASK
        key = Gdk.keyval_to_lower(event.keyval)
        # Ctrl+C copies a selection, as in an editor; with nothing selected it reaches Claude (stop).
        if ctrl and key == Gdk.KEY_c and (shift or self.term.get_has_selection()):
            self.copy()
            return True
        # Ctrl+V pastes text; an image on the clipboard goes to Claude, which pastes images itself.
        if ctrl and key == Gdk.KEY_v and (shift or self.clipboard_has_text()):
            self.paste()
            return True
        if ctrl and key in (Gdk.KEY_equal, Gdk.KEY_plus, Gdk.KEY_minus, Gdk.KEY_0):
            self.font_scale = 1.0 if key == Gdk.KEY_0 else max(0.6, min(2.5, self.font_scale + (0.1 if key != Gdk.KEY_minus else -0.1)))
            self.term.set_font_scale(self.font_scale)
            return True
        return False

    def on_button(self, _term, event):
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button != 3:
            return False
        menu = Gtk.Menu()
        for label, key, mods, handler, sensitive in (
            ("Copy", Gdk.KEY_c, Gdk.ModifierType.CONTROL_MASK, self.copy, self.term.get_has_selection()),
            ("Paste", Gdk.KEY_v, Gdk.ModifierType.CONTROL_MASK, self.paste, True),
            ("Select all", 0, 0, lambda *_: self.term.select_all(), True),
        ):
            item = Gtk.MenuItem(label=label)
            if key:
                item.get_child().set_accel(key, mods)
            item.set_sensitive(sensitive)
            item.connect("activate", handler)
            menu.append(item)
        menu.show_all()
        menu.attach_to_widget(self.term, None)
        menu.popup_at_pointer(event)
        return True

    def on_close(self, *_):
        if not self.alive:
            return False
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=f"Close session {self.info.get('n', '')}?",
        )
        dialog.format_secondary_text(
            "Claude stops. If the session has not opened its pull request yet, the build starts it again in a new window."
        )
        dialog.add_buttons("Keep it open", Gtk.ResponseType.CANCEL, "Close", Gtk.ResponseType.OK)
        answer = dialog.run()
        dialog.destroy()
        return answer != Gtk.ResponseType.OK


def window_server():
    """The chat window's socket, or None when another window has it."""
    for _ in range(2):
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            server.bind(WINDOW_SOCKET)
        except OSError:
            server.close()
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                    s.settimeout(2)
                    s.connect(WINDOW_SOCKET)
                return None  # a window answers on it
            except OSError:
                pass
            try:
                os.unlink(WINDOW_SOCKET)  # left by a window that did not close cleanly
            except OSError:
                pass
            continue
        os.chmod(WINDOW_SOCKET, 0o600)
        server.listen(8)
        return server
    return None


def hand_over(sock_path, token):
    """Gives the session to the chat window that is open, if one is. True when it took it."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(WINDOW_SOCKET)
            s.sendall(json.dumps({"attach": sock_path, "token": token}).encode() + b"\n")
        return True
    except OSError:
        return False


def style():
    Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS.encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def main():
    args = sys.argv[1:]
    if not args:
        print("usage: mewo-session --attach [<host socket>] | mewo-session <info.json>", file=sys.stderr)
        sys.exit(2)
    # Grouped with Mewo Console in the dock (its desktop entry and window class).
    GLib.set_prgname("com.torchcorp.mewo-on-fire.console")
    GLib.set_application_name("Mewo Session")
    if args[0] == "--attach":
        if WebKit2 is None:
            print("mewo-session: the chat needs WebKitGTK for Python (gir1.2-webkit2-4.1)", file=sys.stderr)
            sys.exit(1)
        sock_path = args[1] if len(args) > 1 else ""
        token = os.environ.get("XDG_ACTIVATION_TOKEN") or os.environ.get("DESKTOP_STARTUP_ID") or ""
        server = None
        for _ in range(3):
            if sock_path and hand_over(sock_path, token):
                return
            if not sock_path and os.path.exists(WINDOW_SOCKET) and hand_over("", token):
                return
            server = window_server()
            if server:
                break
            time.sleep(0.2)  # another window is starting: give it the session in a moment
        if server is None:
            sys.exit(1)
        style()
        win = SessionsWindow(server)
        win.show_all()
        win.attach_all()
        if sock_path:
            win.attach(sock_path, "", True)
        GLib.idle_add(win.close_if_empty)
        Gtk.main()
    with open(args[0], encoding="utf-8") as f:
        info = json.load(f)
    GLib.set_prgname(info.get("app_id") or "com.torchcorp.mewo-on-fire.console")
    style()
    win = SessionWindow(info)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
