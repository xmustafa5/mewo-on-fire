BG = "#04070c"
BG2 = "#070c14"
CYAN = "#4fd1ff"
TEXT = "#dbeafe"
DIM = "#7b93ab"
FIRE = "#ff6b35"
AMBER = "#ffb347"
OK = "#3dd68c"
ASH = "#6b7280"

# Black, red, green, yellow, blue, magenta, cyan, white; then the bright ones.
PALETTE = [
    "#0b1220", "#ff3d1f", "#3dd68c", "#ffb347", "#2f6bff", "#b98cff", "#4fd1ff", "#dbeafe",
    "#3a4a5e", "#ff6b35", "#6ee7a8", "#ffd08a", "#6b93ff", "#d4b0ff", "#8fe3ff", "#ffffff",
]

CSS = f"""
