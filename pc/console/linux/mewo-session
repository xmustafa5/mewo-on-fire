#!/usr/bin/env python3
"""Mewo Session for Linux: one build session of "Build with me" in a window
of its own, in the Mewo on Fire look (GTK + the VTE terminal widget).

The daemon writes this file next to its state and starts it with an info
file (JSON): the session's number, goal, feature, worktree, model, the
script to run and the daemon's socket. The script records its pid and then
becomes Claude Code, so the daemon tracks the run as it tracks a headless
one. The header follows the session through the daemon: its state (working,
needs you, finished), its plan status and its pull request.

Ctrl+Shift+C / Ctrl+Shift+V copy and paste, Ctrl+= / Ctrl+- / Ctrl+0 zoom.
"""

import json
import os
import socket
import sys
import threading

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("Vte", "2.91")
from gi.repository import Gdk, GLib, Gtk, Pango, Vte  # noqa: E402

